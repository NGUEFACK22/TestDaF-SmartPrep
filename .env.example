APP_NAME="SYNPHONIE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de données
# Développement simple (défaut, zéro configuration) :
DB_CONNECTION=sqlite
# PostgreSQL local / serveur classique :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=testdaf
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer
# Développement équipe (MySQL) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=testdaf
# DB_USERNAME=root
# DB_PASSWORD=
#
# PostgreSQL serverless (Neon, endpoint pooler) :
# - DB_HOST = l'endpoint pooler (ep-...-pooler.<region>.aws.neon.tech), port 5432
# - DB_SSLMODE=require
# - DB_ENDPOINT = le premier segment du hostname (ex. ep-broad-queen-b5lqx7x0) :
#   requis par le pooler Neon pour le SNI quand le build PHP ne fournit pas un
#   libpq >= 15.3 (géré par app/Database/Connectors/NeonPgsqlConnector.php).
# DB_CONNECTION=pgsql
# DB_HOST=ep-votre-endpoint-pooler.c-7.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=npg_votre_cle_neon
# DB_SSLMODE=require
# DB_ENDPOINT=ep-votre-endpoint
# NB : "channel_binding=require" (présent dans les URLs Neon) n'est PAS supporté
# par les builds PHP XAMPP (libpq ancien) : la connexion SSL reste requise via
# DB_SSLMODE=require. Pour l'activer, utiliser un build PHP >= 8.3 moderne.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Perf prod : database OK <1k users, redis recommandé au-delà
# (queue + cache + sessions partagées entre workers).
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="testdaf@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# TestDaF — Médias (stockage privé des productions candidats + contenus)
# Le disque "local" utilise storage/app/private (non exposé publiquement).
# TESTDAF_MEDIA_DISK=local
# 100 % base de données (Neon, sans objet externe — plus lent) :
# TESTDAF_MEDIA_DISK=database
# Pour S3 / compatible S3 en production :
# TESTDAF_MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# ---------------------------------------------------------------------------
# TestDaF — Intelligence artificielle (fournisseurs interchangeables)
# Les secrets ne doivent JAMAIS être placés dans Git.
AI_ENABLED=false
AI_PROVIDER=gemini
# Modele Gemini courant (les noms de modeles evoluent : verifier sur ai.google.dev)
AI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Endpoint d'un serveur Whisper auto-hébergé (ex. https://whisper.mondomaine.fr/v1)
WHISPER_ENDPOINT=
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2
SPEECHACE_API_KEY=
MAX_AI_REQUESTS=100
AI_AUTO_EVALUATION=true
AI_MANUAL_REVIEW=true

VITE_APP_NAME="${APP_NAME}"
